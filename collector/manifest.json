{
  "manifest_version": 3,
  "name": "ChekCAReto Collector",
  "version": "0.1.1",
  "description": "Αποθηκεύει τιμή, χιλιόμετρα και χρονιά από αγγελίες αυτοκινήτων που βλέπεις στο Facebook, για τον οδηγό τιμών ChekCAReto.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "src/parser.js",
        "src/extract.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChekCAReto",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://*.facebook.com/*"
  ]
}